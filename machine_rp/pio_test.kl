module machine_rp

import testing

fn test_pio_encode() {
    testing.assert_eq_i32(pio_encode_set_pins(1, 0), 0xe001)
    testing.assert_eq_i32(pio_encode_set_pins(0, 31), 0xff00)
    testing.assert_eq_i32(pio_encode_set_pindirs(1, 0), 0xe081)
    testing.assert_eq_i32(pio_encode_nop(0), 0xa042)
    testing.assert_eq_i32(pio_encode_nop(31), 0xbf42)
    testing.assert_eq_i32(pio_encode_jmp(7), 7)
    testing.assert_eq_i32(pio_encode_jmp_not_x(3), 0x0023)
    testing.assert_eq_i32(pio_encode_out_x(1), 0x6021)
    testing.assert_eq_i32(pio_encode_delay(3), 0x0300)
    testing.assert_eq_i32(pio_encode_sideset(1, 1), 0x1000)
    // WS2812-style word at PC0: out x,1 side 0 [3]
    testing.assert_eq_i32(
        pio_encode_out_x(1) | pio_encode_sideset(1, 0) | pio_encode_delay(3),
        0x6321
    )
    testing.assert_eq_i32(pio_clkdiv_int(12000000, 8000000), 1)
    testing.assert_eq_i32(pio_clkdiv_frac(12000000, 8000000), 128)
    testing.assert_eq_i32(pio_base(0), 0x50200000)
    testing.assert_eq_i32(pio_reset_bit_rp2350(2), 13)
    testing.assert_eq_i32(pio_funcsel(2), 8)
}

fn test_version_pio() {
    testing.assert_eq_i32(version(), 10)
}
