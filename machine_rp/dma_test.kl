module machine_rp

import testing

fn test_dma_consts() {
    testing.assert_eq_i32(dma_base(), 0x50000000)
    testing.assert_eq_i32(dma_ch_base(0), 0x50000000)
    testing.assert_eq_i32(dma_ch_base(1), 0x50000040)
    testing.assert_eq_i32(dma_dreq_spi0_tx(), 16)
    testing.assert_eq_i32(dma_dreq_spi1_tx(), 18)
    testing.assert_eq_i32(dma_dreq_spi0_tx_rp2350(), 24)
    testing.assert_eq_i32(dma_dreq_spi1_tx_rp2350(), 26)
    testing.assert_eq_i32(dma_dreq_pio_tx(0, 0), 0)
    testing.assert_eq_i32(dma_dreq_pio_tx(0, 1), 1)
    testing.assert_eq_i32(dma_dreq_pio_tx_rp2350(0, 1), 1)
    testing.assert_eq_i32(dma_dreq_pio_tx(1, 0), 8)
    testing.assert_eq_i32(dma_dreq_pio_tx(2, 3), 19)
}

fn test_dma_ctrl_rp2350() {
    // ch0, SPI1 TX, incr_read, ring=1 (2-byte)
    let c = dma_ctrl_byte_tx(0, 26, 1, 1, 1)
    testing.assert_eq_i32(c & 1, 1) // EN
    testing.assert_eq_i32((c >> 4) & 1, 1) // INCR_READ
    testing.assert_eq_i32((c >> 8) & 15, 1) // RING_SIZE
    testing.assert_eq_i32((c >> 13) & 15, 0) // CHAIN_TO self
    testing.assert_eq_i32((c >> 17) & 63, 26) // TREQ
    testing.assert_eq_i32((c >> 23) & 1, 1) // IRQ_QUIET
}

fn test_dma_ctrl_rp2040() {
    let c = dma_ctrl_byte_tx(3, 18, 1, 0, 0)
    testing.assert_eq_i32(c & 1, 1)
    testing.assert_eq_i32((c >> 4) & 1, 1)
    testing.assert_eq_i32((c >> 6) & 15, 0)
    testing.assert_eq_i32((c >> 11) & 15, 3)
    testing.assert_eq_i32((c >> 15) & 63, 18)
    testing.assert_eq_i32((c >> 21) & 1, 1)
}
