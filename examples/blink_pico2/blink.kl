// Raspberry Pi Pico 2 (RP2350, Arm) on-board LED = GPIO 25.
import "../../machine_rp" machine

@[link("startup.s")]
@[link("image_def.S")]
fn main() {
    let led = machine.pin_out_rp2350(25)
    while true {
        led.toggle()
        let mut i: i32 = 0
        while i < 500000 {
            i = i + 1
        }
    }
}
