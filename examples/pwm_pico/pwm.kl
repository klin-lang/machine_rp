// Raspberry Pi Pico (RP2040) onboard LED = GPIO 25 = PWM slice 4 channel B.
// No PLL in this freestanding example — ROSC ~6 MHz; pass sys_clk_hz explicitly.
// After a 125 MHz clk_sys init, use 125000000 instead.
import "../../machine_rp" machine

@[link("startup.s")]
@[link("boot2_w25q080.S")]
fn main() {
    let led = machine.pwm_out(25, 6000000)
    led.freq(1000)
    while true {
        let mut d: i32 = 0
        while d <= 65535 {
            led.duty_u16(d)
            let mut i: i32 = 0
            while i < 500 {
                i = i + 1
            }
            d = d + 1024
        }
        d = 65535
        while d >= 0 {
            led.duty_u16(d)
            let mut i: i32 = 0
            while i < 500 {
                i = i + 1
            }
            d = d - 1024
        }
    }
}
